<Project Sdk="Microsoft.NET.Sdk">

    <!-- Reads a built plugin and prints its entry for a plugin catalog
         (index.json). Used by the release workflows; see Program.cs. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- The same platform as the agent, so any plugin it can load loads here
         too (the Windows plugin needs WinForms and WinRT). Elsewhere it builds
         for net10.0 and reads the plugins of that system. -->
    <PropertyGroup Condition="'$(HostOs)' == 'windows'">
        <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>
    <PropertyGroup Condition="'$(HostOs)' != 'windows'">
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\HomeAssistant.Agent.Core\HomeAssistant.Agent.Core.csproj" />
    </ItemGroup>

</Project>
