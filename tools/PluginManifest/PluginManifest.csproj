<Project Sdk="Microsoft.NET.Sdk">

    <!-- Reads a built plugin and prints its entry for a plugin catalog
         (index.json). Used by the release workflows; see Program.cs. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The same platform as the agent, so any plugin it can load loads
             here too (the Windows plugin needs WinForms and WinRT). -->
        <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\HomeAssistant.Agent.Core\HomeAssistant.Agent.Core.csproj" />
    </ItemGroup>

</Project>
