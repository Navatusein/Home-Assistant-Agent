<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net10.0-windows if the plugin needs Windows APIs. -->
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- The release workflow overrides it from the tag (v1.2.3). -->
        <Version>1.0.0</Version>
    </PropertyGroup>

    <!-- Shown in the agent and in the plugin catalog. -->
    <PropertyGroup>
        <PluginName>MyPlugin</PluginName>
        <PluginDescription>What the plugin does, in one line.</PluginDescription>
        <PluginAuthor>Your Name</PluginAuthor>
        <PluginRepository>https://github.com/your-account/MyPlugin</PluginRepository>
        <!-- <PluginHomepage>https://...</PluginHomepage> -->
        <!-- <PluginIcon>icon.png</PluginIcon>   square PNG, 64x64 or larger -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HomeAssistant.Agent.Plugin.Sdk" Version="SDK_VERSION" />
    </ItemGroup>

</Project>
