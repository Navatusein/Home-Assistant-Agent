<UserControl
  x:Class="HomeAssistant.Agent.Views.Pages.PluginSettingsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:HomeAssistant.Agent.ViewModels.Settings.Controls"
  xmlns:s="using:HomeAssistant.Agent.ViewModels.Settings"
  xmlns:u="https://irihi.tech/ursa"
  xmlns:views="using:HomeAssistant.Agent.Views"
  xmlns:vm="using:HomeAssistant.Agent.ViewModels.Pages"
  x:DataType="vm:PluginSettingsViewModel"
>
  <UserControl.Styles>
    <!-- Which host runs a feature: the service ones also work before sign-in. -->
    <Style Selector="Border.host">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
    </Style>
    <!-- Room for the expand chevron (16) and its spacing (12) that features
         with settings have, so every switch lines up in one column. -->
    <Style Selector="ToggleSwitch.noDetail">
      <Setter Property="Margin" Value="0,0,28,0" />
    </Style>
  </UserControl.Styles>

  <!-- Save applies every section, so the status and the buttons are the
       Settings page's, bound to the one shared view model. -->
  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" Classes="page">
      <StackPanel x:DataType="s:PluginSettingsSectionViewModel" Classes="groups" DataContext="{Binding Section}">

        <!-- What the plugin says about itself (PluginInfo, from its project
             file). Every part is optional; links are http(s) only. -->
        <Grid ColumnDefinitions="Auto,*">
          <Panel Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
            <Image IsVisible="{Binding HasPluginIcon}" Source="{Binding PluginIcon}" />
            <PathIcon
              Width="40"
              Height="40"
              Data="{DynamicResource SemiIconPuzzle}"
              IsVisible="{Binding !HasPluginIcon}"
            />
          </Panel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Classes="caption" Text="{Binding Byline}" />
            <TextBlock
              Margin="0,6,0,0"
              IsVisible="{Binding HasDescription}"
              Text="{Binding Description}"
              TextWrapping="Wrap"
            />
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="16">
              <HyperlinkButton Content="Homepage" IsVisible="{Binding HasHomepage}" NavigateUri="{Binding Homepage}" />
              <HyperlinkButton Content="Repository" IsVisible="{Binding HasRepository}" NavigateUri="{Binding Repository}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Plugin-wide settings: a card per run of controls, one per group. -->
        <ItemsControl IsVisible="{Binding HasBlocks}" ItemsSource="{Binding Blocks}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="20" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="c:SettingBlock">
              <u:SettingsCardGroup
                Description="{Binding Description}"
                Header="{Binding Header}"
                ItemTemplate="{x:Static views:AppTemplates.Instance}"
                ItemsSource="{Binding Controls}"
              />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- One card per feature with its switch. A feature with settings of
             its own shows them under the row; they stay visible but inactive
             while the feature is off. -->
        <u:SettingsCardGroup Header="Features" IsVisible="{Binding HasFeatures}" ItemsSource="{Binding Features}">
          <u:SettingsCardGroup.ItemTemplate>
            <DataTemplate x:DataType="s:FeatureSettingViewModel">
              <!-- One card either way: the group hides the separator of the
                   last element in a container, so two cards (one hidden)
                   would lose the line under every feature with settings. -->
              <u:SettingsCard Description="{Binding Description}" Detail="{Binding Detail}">
                <u:SettingsCard.Content>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    <Border Classes="host" ToolTip.Tip="{Binding HostToolTip}">
                      <TextBlock Classes="caption" Text="{Binding HostLabel}" />
                    </Border>
                  </StackPanel>
                </u:SettingsCard.Content>
                <u:SettingsCard.RightContent>
                  <ToggleSwitch
                    Classes.noDetail="{Binding !HasControls}"
                    IsChecked="{Binding IsEnabled}"
                    Theme="{DynamicResource SimpleToggleSwitch}"
                    ToolTip.Tip="Enable feature"
                  />
                </u:SettingsCard.RightContent>
                <u:SettingsCard.DetailTemplate>
                  <DataTemplate x:DataType="s:FeatureSettingViewModel">
                    <ItemsControl Margin="0,0,0,8" IsEnabled="{Binding IsEnabled}" ItemsSource="{Binding Blocks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="c:SettingBlock">
                          <StackPanel>
                            <StackPanel Margin="72,12,16,4" IsVisible="{Binding HasHeader}" Spacing="2">
                              <TextBlock Classes="heading" Text="{Binding Header}" />
                              <TextBlock Classes="caption" IsVisible="{Binding HasDescription}" Text="{Binding Description}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Controls}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </u:SettingsCard.DetailTemplate>
              </u:SettingsCard>
            </DataTemplate>
          </u:SettingsCardGroup.ItemTemplate>
        </u:SettingsCardGroup>

        <!-- Host-provided, not part of the plugin's descriptor: every plugin
             gets it. -->
        <u:SettingsCardGroup Header="Diagnostics">
          <u:SettingsCard Content="Log level" Description="Detail written to the log by this plugin." Icon="{DynamicResource SemiIconArticle}">
            <u:SettingsCard.RightContent>
              <ComboBox Classes="field" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevel}" />
            </u:SettingsCard.RightContent>
          </u:SettingsCard>
        </u:SettingsCardGroup>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Classes="footer">
      <u:Banner
        Classes="Bordered"
        CanClose="True"
        Content="{Binding Settings.StatusMessage}"
        IsVisible="{Binding Settings.IsStatusOpen, Mode=TwoWay}"
        Type="{Binding Settings.StatusSeverity}"
      />
      <StackPanel
        HorizontalAlignment="Right"
        IsEnabled="{Binding Settings.IsNotBusy}"
        Orientation="Horizontal"
        Spacing="8"
      >
        <Button Command="{Binding Settings.CancelCommand}" Content="Cancel" />
        <Button
          Classes="Primary"
          Command="{Binding Settings.SaveCommand}"
          Content="Save"
          Theme="{DynamicResource SolidButton}"
        />
      </StackPanel>
    </StackPanel>

  </Grid>
</UserControl>
